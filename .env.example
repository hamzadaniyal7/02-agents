# Required for the `anthropic` model provider (the default).
# Alternatively run `ant auth login` and leave this unset -- the SDK picks up the profile.
ANTHROPIC_API_KEY=

# Any config key can be overridden from the environment with an ACTCHECK_ prefix:
# ACTCHECK_MODEL=claude-opus-5
# ACTCHECK_MAX_STEPS=24
# ACTCHECK_CHECKER=model
